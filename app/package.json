{
  "name": "aion2-wiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AION2 非公式Wiki（静的サイト / GitHub Pages）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "content:samples": "cross-env INCLUDE_SAMPLES=1 tsx scripts/build-content.ts",
    "dev": "npm run content && vite",
    "dev:samples": "npm run content:samples && vite",
    "build": "npm run content && vite build",
    "build:samples": "npm run content:samples && vite build",
    "preview": "vite preview",
    "typecheck": "npm run content && tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "eval:retrieval": "tsx scripts/retrieval-eval.ts",
    "watch": "node scripts/watch-sources.mjs",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@google/genai": "^2.27.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.52.0",
    "minisearch": "^7.2.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "github-slugger": "^2.0.0",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "jsdom": "^30.1.2",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.9",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
